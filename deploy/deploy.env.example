# Template for the private deployment env file (copy to deploy/<name>.env, mode 600, never commit).
# Every secret below must be a fresh random value unique to this environment.
RELEASE=replace-with-release-id
APP_DOMAIN=demo.example.org
POSTGRES_DB=cognuance
POSTGRES_SUPERUSER=cognuance_bootstrap
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_HEX
MIGRATOR_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS
DEMO_ACCOUNT_PASSWORD=REPLACE_WITH_RANDOM_TOKEN
MODEL_MODE=gru
# Absolute host paths: verified model bundles (mounted read-only into api) and the ops workspace.
ARTIFACT_ROOT=/srv/cognuance/artifacts
DATA_ROOT=/srv/cognuance/data
# Hosted: default 80/443 and deploy/Caddyfile. Local HTTP verification: Caddyfile.local + WEB_*_PUBLISH.
# WEB_HTTP_PUBLISH=127.0.0.1:8088
# WEB_HTTPS_PUBLISH=127.0.0.1:8443
# CADDYFILE=./deploy/Caddyfile.local
