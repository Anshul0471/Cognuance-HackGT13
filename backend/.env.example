APP_ENV=development
APP_NAME=COGNUANCE
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://cognitive_app:REPLACE_WITH_LOCAL_RANDOM_HEX@127.0.0.1:5432/cognitive_monitoring
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
JWT_ISSUER=cognuance-api
JWT_AUDIENCE=cognuance-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
ML_DEVICE=cpu
MODEL_MODE=unconfigured
MODEL_ARTIFACT_DIR=./artifacts
SYNTHETIC_DATA_DIR=./data/synthetic
SEQUENCE_LENGTH=6
RANDOM_SEED=42
DEMO_MODE=true
LOG_LEVEL=INFO
DEMO_ACCOUNT_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD
# guide 05: operational limits (defaults shown; omit to use them)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
CURSOR_TTL_SECONDS=3600
RECOVERY_DEFAULT_LIMIT=100
